# Optional. Enables authenticated GitHub API requests for server fallback.
GITHUB_TOKEN=

# Optional. Enables GitHub OAuth login.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# Required only if OAuth is enabled. Used to sign/encrypt auth cookies.
AUTH_COOKIE_SECRET=

# Optional. Enables Gemini explanation rewriting.
GEMINI_API_KEY=
